{
  "id": null,
  "uid": "airflow-lakehouse",
  "title": "Airflow overview",
  "tags": ["airflow", "lakehouse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Scheduler heartbeat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(airflow_scheduler_heartbeat)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Task successes and failures",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(airflow_ti_successes[5m]))", "legendFormat": "successes", "refId": "A"},
        {"expr": "sum(rate(airflow_ti_failures[5m]))", "legendFormat": "failures", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "DAG run duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "airflow_dagrun_duration_success", "legendFormat": "{{dag_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Running tasks",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(airflow_executor_running_tasks)", "legendFormat": "running", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
